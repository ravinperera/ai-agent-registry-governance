{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/governance-resource.schema.json",
  "title": "Agentic Resource Governance Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resource", "owner", "source", "capabilities", "permissions", "delegation", "humanOversight", "provenance", "risk", "governance", "runtime"],
  "properties": {
    "schemaVersion": {"const": "1.1"},
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "displayName", "type", "description"],
      "properties": {
        "identifier": {"type": "string", "pattern": "^urn:air:[a-z0-9.-]+(?::[a-z0-9._-]+)+$"},
        "displayName": {"type": "string", "minLength": 3},
        "type": {"type": "string", "minLength": 3},
        "description": {"type": "string", "minLength": 10},
        "catalogEntry": {"type": "string"}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "serviceOwner", "securityContact"],
      "properties": {
        "team": {"type": "string", "minLength": 2},
        "serviceOwner": {"type": "string", "minLength": 2},
        "securityContact": {"type": "string", "format": "email"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "license"],
      "properties": {
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
        "license": {"type": "string", "minLength": 2}
      },
      "oneOf": [{"required": ["commit"]}, {"required": ["version"]}, {"required": ["digest"]}]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "shell", "network", "secrets", "dataClassifications"],
      "properties": {
        "filesystem": {"enum": ["none", "read", "write"]},
        "shell": {"enum": ["none", "read", "execute"]},
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["egress", "allowedDestinations"],
          "properties": {
            "egress": {"enum": ["none", "restricted", "unrestricted"]},
            "allowedDestinations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "allOf": [{
            "if": {"properties": {"egress": {"const": "restricted"}}, "required": ["egress"]},
            "then": {"properties": {"allowedDestinations": {"minItems": 1}}}
          }]
        },
        "secrets": {"enum": ["none", "metadata", "read"]},
        "dataClassifications": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["public", "internal", "confidential", "restricted"]}
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "maxHops", "scopeNarrowingRequired", "allowedDelegates"],
      "properties": {
        "allowed": {"type": "boolean"},
        "maxHops": {"type": "integer", "minimum": 0, "maximum": 10},
        "scopeNarrowingRequired": {"type": "boolean"},
        "allowedDelegates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
      },
      "allOf": [
        {
          "if": {"properties": {"allowed": {"const": false}}, "required": ["allowed"]},
          "then": {"properties": {"maxHops": {"const": 0}, "allowedDelegates": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"allowed": {"const": true}}, "required": ["allowed"]},
          "then": {"properties": {"maxHops": {"minimum": 1}, "scopeNarrowingRequired": {"const": true}}}
        }
      ]
    },
    "humanOversight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "approvalRequiredFor", "delegatedApprovalAllowed", "approvalProvenanceRequired"],
      "properties": {
        "mode": {"enum": ["none", "session", "per-consequential-action", "always"]},
        "approvalRequiredFor": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "delegatedApprovalAllowed": {"type": "boolean"},
        "approvalProvenanceRequired": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "none"}}, "required": ["mode"]},
          "then": {"properties": {"approvalRequiredFor": {"maxItems": 0}, "approvalProvenanceRequired": {"const": false}}}
        },
        {
          "if": {"properties": {"mode": {"enum": ["per-consequential-action", "always"]}}, "required": ["mode"]},
          "then": {"properties": {"approvalRequiredFor": {"minItems": 1}, "approvalProvenanceRequired": {"const": true}}}
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "mechanism", "tamperEvident", "recordsOriginatingHuman", "recordsDelegationChain"],
      "properties": {
        "required": {"type": "boolean"},
        "mechanism": {"type": "string", "minLength": 2},
        "tamperEvident": {"type": "boolean"},
        "recordsOriginatingHuman": {"type": "boolean"},
        "recordsDelegationChain": {"type": "boolean"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "rationale"],
      "properties": {
        "tier": {"enum": ["low", "medium", "high", "critical"]},
        "rationale": {"type": "string", "minLength": 10}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "retirementPath"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected", "suspended", "retired"]},
        "approvedBy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "approvedAt": {"type": "string", "format": "date"},
        "reviewBy": {"type": "string", "format": "date"},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 2}},
        "rejectionReason": {"type": "string", "minLength": 10},
        "retirementPath": {"type": "string", "minLength": 10}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
          "then": {"required": ["approvedBy", "approvedAt", "reviewBy"], "properties": {"evidence": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "rejected"}}, "required": ["status"]},
          "then": {"required": ["rejectionReason"]}
        }
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sandboxRequired", "monitoringRequired", "auditLoggingRequired"],
      "properties": {
        "sandboxRequired": {"type": "boolean"},
        "monitoringRequired": {"type": "boolean"},
        "auditLoggingRequired": {"type": "boolean"}
      }
    }
  }
}
